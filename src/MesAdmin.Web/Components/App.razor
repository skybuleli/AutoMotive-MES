@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <script>
        // 首帧恢复主题偏好（暗色为默认），必须在样式表加载前执行以避免闪烁；
        // body 尚未解析，内联背景在 DOMContentLoaded 时设置（防止暗色默认下的白闪）。
        try {
            var light = localStorage.getItem('mes.theme') === 'light';
            if (light)
                document.documentElement.setAttribute('data-mes-theme', 'light');
            document.addEventListener('DOMContentLoaded', function () {
                document.body.style.background = light ? '#F5F5FA' : '#191925';
            });
        } catch (e) { console.debug('主题偏好读取失败', e); }
    </script>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["MesAdmin.Web.styles.css"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <ReconnectModal />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
    <script src="@Assets["js/theme-interop.js"]"></script>
    <script src="@Assets["js/auth-interop.js"]"></script>
    <script src="@Assets["js/spc-chart-interop.js"]"></script>
    <script src="@Assets["js/gantt-interop.js"]"></script>
    <script src="@Assets["js/report-interop.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
