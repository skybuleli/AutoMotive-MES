@page "/oee"
@attribute [StreamRendering]
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MesAdmin.Web.Services
@using MesAdmin.Domain.Models
@inject OeeHubClient Hub
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>设备 OEE - AutoMES</PageTitle>

<MudStack Spacing="2">
    <MesPageHeader Kicker="M05 · Equipment OEE" Title="设备综合效率">
        <HeaderActions>
            @if (Hub.Health is not null)
            {
                <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Class="section-copy">通道写入</MudText>
                        <MudText Typo="Typo.subtitle2">@Hub.Health.Written.ToString("N0")</MudText>
                    </MudStack>
                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Class="section-copy">通道读取</MudText>
                        <MudText Typo="Typo.subtitle2">@Hub.Health.Read.ToString("N0")</MudText>
                    </MudStack>
                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Class="section-copy">使用率</MudText>
                        <MudText Typo="Typo.subtitle2" Color="@(Hub.Health.Utilization > 0.8 ? Color.Warning : Color.Success)">
                            @(Hub.Health.Utilization.ToString("P1"))
                        </MudText>
                    </MudStack>
                </MudStack>
            }
        </HeaderActions>
    </MesPageHeader>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <MudAlert Severity="@(_isConnected ? Severity.Success : Severity.Warning)" Variant="Variant.Filled" Dense>
            @_statusMessage
        </MudAlert>
    }

    @if (_snapshot.Count == 0)
    {
        <MesStateCard Loading="true" Text="等待设备数据采集..." Hint="PLC 管道启动后约 5s 开始推送 OEE" />
    }
    else
    {
        <div class="oee-grid">
            @foreach (var oee in _snapshot)
            {
                <MudPaper Class="glass-kpi-card">
                    <MudStack Spacing="2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                <MesStatusDot Status="@GetDotStatus(oee)" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@oee.EquipmentCode</MudText>
                            </MudStack>
                            <MudChip T="string" Color="@GetGradeColor(oee.Grade)" Size="Size.Small" Variant="Variant.Outlined">
                                @oee.Grade
                            </MudChip>
                        </MudStack>

                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="kpi-label">OEE</MudText>
                            <MudText Typo="Typo.h3" Class="@($"kpi-value {GetGradeClass(oee.Grade)}")">
                                @(oee.Oee.ToString("P1"))
                            </MudText>
                        </MudStack>

                        <MudStack Row Spacing="4" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="kpi-label">可用率</MudText>
                                <MudText Typo="Typo.body2">@(oee.Availability.ToString("P0"))</MudText>
                            </MudStack>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="kpi-label">性能率</MudText>
                                <MudText Typo="Typo.body2">@(oee.Performance.ToString("P0"))</MudText>
                            </MudStack>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="kpi-label">良品率</MudText>
                                <MudText Typo="Typo.body2">@(oee.Quality.ToString("P0"))</MudText>
                            </MudStack>
                        </MudStack>

                        <MudText Typo="Typo.caption" Class="kpi-sub">
                            更新：@oee.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </MudText>
                    </MudStack>
                </MudPaper>
            }
        </div>

        <MudPaper Class="oee-trend-card">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="section-copy">TREND · 实时趋势</MudText>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">OEE 四率走势</MudText>
                </MudStack>
                <MudSelect T="string" Variant="Variant.Outlined" Dense="true"
                           Style="max-width:220px;"
                           Value="@_selectedEquipment" ValueChanged="@OnEquipmentSelected">
                    @foreach (var eq in EquipmentCodes)
                    {
                        <MudSelectItem Value="@eq">@eq</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
            <div id="oee-trend-chart" class="oee-trend-chart"></div>
        </MudPaper>
    }
</MudStack>

@code {
    // 趋势窗口：60 点 × 5s 推送 ≈ 5 分钟滚动历史
    private const int TrendCapacity = 60;
    private const string ChartId = "oee-trend-chart";

    private bool _isConnected;
    private string _statusMessage = string.Empty;
    private IReadOnlyList<OeeRecord> _snapshot = [];

    // 每设备滚动历史；仅在渲染同步上下文（InvokeAsync）内读写，无需加锁
    private readonly Dictionary<string, List<OeeRecord>> _history = new(StringComparer.Ordinal);
    private string? _selectedEquipment;
    private bool _chartDirty;

    /// <summary>设备选择器选项：历史键 ∪ 当前快照，按编码排序。</summary>
    private IEnumerable<string> EquipmentCodes
        => _history.Keys.Union(_snapshot.Select(o => o.EquipmentCode), StringComparer.Ordinal)
            .OrderBy(c => c, StringComparer.Ordinal);

    protected override void OnInitialized()
        => Hub.Changed += OnHubChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Hub.StartAsync();
            _isConnected = true;
            _statusMessage = "SignalR 已连接，实时接收 OEE 数据";
            ApplySnapshot(Hub.Snapshot());
            StateHasChanged();
            return;
        }

        // 图表容器随数据分支条件渲染，必须在 DOM 提交后推送，_chartDirty 防重复
        if (_chartDirty && _selectedEquipment is not null && _history.TryGetValue(_selectedEquipment, out var series))
        {
            _chartDirty = false;
            var payload = BuildSeriesPayload(series);
            await (series.Count > 1
                ? JS.InvokeVoidAsync("oeeTrend.update", ChartId, payload)
                : JS.InvokeVoidAsync("oeeTrend.init", ChartId, payload));
        }
    }

    // SignalR 回调线程触发；切到渲染同步上下文后读取线程安全快照并刷新。
    private void OnHubChanged()
        => _ = InvokeAsync(() =>
        {
            ApplySnapshot(Hub.Snapshot());
            StateHasChanged();
        });

    private void ApplySnapshot(IReadOnlyList<OeeRecord> snapshot)
    {
        _snapshot = snapshot;

        foreach (var oee in snapshot)
        {
            if (!_history.TryGetValue(oee.EquipmentCode, out var points))
                _history[oee.EquipmentCode] = points = [];

            // 时间戳乱序防护：仅接受单调递增的采样
            if (points.Count > 0 && oee.Timestamp <= points[^1].Timestamp) continue;

            points.Add(oee);
            if (points.Count > TrendCapacity) points.RemoveAt(0);
        }

        _selectedEquipment ??= EquipmentCodes.FirstOrDefault();
        _chartDirty = true;
    }

    private void OnEquipmentSelected(string? code)
    {
        if (code is null || code == _selectedEquipment) return;
        _selectedEquipment = code;
        _chartDirty = true;
        StateHasChanged();
    }

    private static object BuildSeriesPayload(List<OeeRecord> points)
        => new
        {
            times = points.Select(r => r.Timestamp.ToLocalTime().ToString("HH:mm:ss")).ToArray(),
            oee = points.Select(r => Math.Round(r.Oee * 100, 1)).ToArray(),
            availability = points.Select(r => Math.Round(r.Availability * 100, 1)).ToArray(),
            performance = points.Select(r => Math.Round(r.Performance * 100, 1)).ToArray(),
            quality = points.Select(r => Math.Round(r.Quality * 100, 1)).ToArray(),
        };

    private static MesDotStatus GetDotStatus(OeeRecord oee)
        => oee.Oee switch
        {
            >= 0.85 => MesDotStatus.Running,
            >= 0.70 => MesDotStatus.Idle,
            > 0 => MesDotStatus.Alarm,
            _ => MesDotStatus.Offline,
        };

    private static Color GetGradeColor(OeeGrade grade)
        => grade switch
        {
            OeeGrade.S => Color.Success,
            OeeGrade.A => Color.Warning,
            _ => Color.Error,
        };

    private static string GetGradeClass(OeeGrade grade)
        => grade switch
        {
            OeeGrade.S => "oee-grade-s",
            OeeGrade.A => "oee-grade-a",
            _ => "oee-grade-b",
        };

    // 仅退订本组件事件并释放图表；OeeHubClient 是应用级单例，其连接生命周期不由页面组件管理
    // （组件释放时不应释放共享单例连接，否则再次进入页面会 ObjectDisposedException）。
    public async ValueTask DisposeAsync()
    {
        Hub.Changed -= OnHubChanged;
        try
        {
            await JS.InvokeVoidAsync("oeeTrend.dispose", ChartId);
        }
        catch (JSDisconnectedException)
        {
            // 电路已断开，浏览器端图表随页面销毁，无需清理
        }
    }
}
