    private static string GetMaintenanceTypeLabel(string type) => type switch
    {
        "CycleBased" => "循环次数",
        "TimeBased" => "时间间隔",
        _ => type
    };

    private static Color GetTypeChipColor(string type) => type switch
    {
        "CycleBased" => Color.Info,
        "TimeBased" => Color.Primary,
        _ => Color.Default
    };

    private static string GetTriggerLabel(string trigger) => trigger switch
    {
        "CycleTrigger" => "循环触发",
        "TimeTrigger" => "时间触发",
        _ => trigger
    };

    private static string GetOrderStatusLabel(string status) => status switch
    {
        "Open" => "待执行",
        "InProgress" => "执行中",
        "Completed" => "已完成",
        "Cancelled" => "已取消",
        _ => status
    };

    private static Color GetOrderStatusColor(string status) => status switch
    {
        "Open" => Color.Warning,
        "InProgress" => Color.Primary,
        "Completed" => Color.Success,
        "Cancelled" => Color.Default,
        _ => Color.Default
    };

    private static string FormatThreshold(MaintenancePlanDto plan) => plan.MaintenanceType switch
    {
        "TimeBased" => $"{plan.ThresholdValue:F0} 天",
        _ => $"{plan.ThresholdValue:F0} 次循环"
    };

