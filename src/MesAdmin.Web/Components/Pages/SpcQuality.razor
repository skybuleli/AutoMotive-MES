@page "/spc"
@attribute [StreamRendering]
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using MesAdmin.Web.Services
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject MesApiClient Api
@inject ILogger<SpcQuality> PageLogger

<PageTitle>SPC 质量管理 - AutoMES</PageTitle>

<MudStack Spacing="2">
    <MesPageHeader Kicker="T2.5 · SPC Quality Management" Title="SPC 质量管理"
                  Description="控制图 · 检验记录 · 不合格品处置 · 8D 闭环" />

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense>
            @_errorMessage
        </MudAlert>
    }

    @* ── Tab 导航 ── *@
    <MudPaper Class="module-card pa-4">
        <MudTabs @bind-ActivePanelIndex="_activeTab" Border="false" Elevation="0"
                 CenterContent="false" Position="Position.Top" ApplyEffectsToContainer="true">

            <MudTabPanel Text="SPC 控制图" Icon="@Icons.Material.Filled.Analytics">
                @* ── SPC 控制图内容 ── *@
                <MudStack Spacing="2" Class="pa-4">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudSelect T="string" Label="选择特性" Variant="Variant.Outlined"
                                   Value="_selectedCharCode" ValueChanged="OnCharCodeChanged"
                                   Style="min-width:200px;">
                            @foreach (var c in CharacteristicOptions)
                            {
                                <MudSelectItem Value="c">@c — @GetCharacteristicName(c)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="_isLoading"
                                       OnClick="LoadChartDataAsync" Size="Size.Small" />

                        @if (_spcSamples.Count >= 2)
                        {
                            var mean = _spcSamples.Average(s => s.Mean);
                            var avgStdDev = _spcSamples.Average(s => s.StdDev);
                            var cpk = avgStdDev > 0
                                ? Math.Min((106 - mean) / (3 * avgStdDev),
                                           (mean - 94) / (3 * avgStdDev))
                                : 0.0;
                            <MudChip T="string" Color="@(cpk >= 1.33 ? Color.Success : cpk >= 1.0 ? Color.Warning : Color.Error)"
                                     Size="Size.Small" Variant="Variant.Outlined">
                                Cpk: @cpk.ToString("F4")
                            </MudChip>
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                子组: @_spcSamples.Count
                            </MudChip>
                        }
                    </MudStack>

                    @if (_isLoading && _spcSamples.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Class="section-copy">加载 SPC 样本数据...</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else if (_spcSamples.Count >= 2)
                    {
                        <div id="xbarChart" style="width:100%; height:450px; border-radius:12px;"></div>
                        <div id="rChart" style="width:100%; height:250px; border-radius:12px;"></div>
                    }
                    else
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body1">暂无 @_selectedCharCode 的 SPC 样本数据</MudText>
                                <MudText Typo="Typo.body2" Class="section-copy">当采集到至少 2 个子组后，X̄-R 控制图将自动显示。</MudText>
                            </MudStack>
                        </MudPaper>
                    }

                    @* SPC 告警列表 *@
                    @if (_spcAlerts.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600; margin-top:16px;">
                            判异告警
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ml-2">
                                @_spcAlerts.Count(a => !a.IsAcknowledged) 未确认
                            </MudChip>
                        </MudText>
                        <MudTable Items="@_spcAlerts" Dense="true" Hover="true" Striped="true"
                                  Elevation="0" Class="module-card">
                            <HeaderContent>
                                <MudTh>规则</MudTh>
                                <MudTh>等级</MudTh>
                                <MudTh>描述</MudTh>
                                <MudTh>状态</MudTh>
                                <MudTh>确认人</MudTh>
                                <MudTh>时间</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="规则">Rule @context.RuleType</MudTd>
                                <MudTd DataLabel="等级">
                                    <MudChip T="string" Size="Size.Small"
                                             Color='@(context.AlertLevel == "Critical" ? Color.Error : context.AlertLevel == "OutOfControl" ? Color.Warning : Color.Info)'
                                             Variant="Variant.Outlined">
                                        @context.AlertLevel
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="描述" Style="font-size:0.85rem;">@context.Description</MudTd>
                                <MudTd DataLabel="状态">
                                    @if (context.IsAcknowledged)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">已确认</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">待确认</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="确认人">@(context.AcknowledgedBy ?? "-")</MudTd>
                                <MudTd DataLabel="时间">@context.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="操作">
                                    @if (!context.IsAcknowledged)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                   OnClick="() => OpenAlertAckDialog(context)">
                                            确认
                                        </MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>

                @* SPC 告警确认对话框 *@
                <MudDialog @bind-Visible="_showAlertAckDialog">
                    <DialogContent>
                        @if (_selectedAlert is not null)
                        {
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6">确认判异告警 — @_selectedAlert.CharacteristicCode</MudText>
                                <MudText Typo="Typo.body2" Class="kpi-label">@_selectedAlert.Description</MudText>
                                <MudTextField Label="确认员工号" Variant="Variant.Outlined" @bind-Value="_alertAckBy" />
                                <MudTextField Label="处置措施（可选）" Variant="Variant.Outlined" Lines="2" @bind-Value="_alertActionTaken" />
                                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                           OnClick="AcknowledgeAlertAsync" Disabled="_isActionLoading" FullWidth="true">
                                    确认告警
                                </MudButton>
                            </MudStack>
                        }
                    </DialogContent>
                </MudDialog>
            </MudTabPanel>

            <MudTabPanel Text="检验记录" Icon="@Icons.Material.Filled.FactCheck">
                <MudStack Spacing="2" Class="pa-4">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small">
                            <MudButton OnClick='() => OnRecordStageChanged("Iq")'
                                       Variant='@(_recordStage == "Iq" ? Variant.Filled : Variant.Outlined)'
                                       Color='@(_recordStage == "Iq" ? Color.Primary : Color.Default)'>
                                IQC 来料检验
                            </MudButton>
                            <MudButton OnClick='() => OnRecordStageChanged("Ipqc")'
                                       Variant='@(_recordStage == "Ipqc" ? Variant.Filled : Variant.Outlined)'
                                       Color='@(_recordStage == "Ipqc" ? Color.Primary : Color.Default)'>
                                IPQC 过程巡检
                            </MudButton>
                        </MudButtonGroup>
                        @if (_recordStage == "Iq")
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateIqcDialog">
                                新建 IQC
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateIpqcDialog">
                                新建 IPQC
                            </MudButton>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="_isLoading"
                                       OnClick="LoadQualityRecordsAsync" Size="Size.Small" />
                    </MudStack>

                    @if (_isLoading && _qualityRecords.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Class="section-copy">加载检验记录...</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else if (_qualityRecords.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body1">暂无 @GetStageLabel(_recordStage) 记录</MudText>
                                <MudText Typo="Typo.body2" Class="section-copy">检验完成后记录将自动出现在此处。</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else
                    {
                        <MudTable Items="@_qualityRecords" Dense="true" Hover="true" Striped="true"
                                  Elevation="0" Class="module-card">
                            <HeaderContent>
                                <MudTh>编码</MudTh>
                                <MudTh>名称</MudTh>
                                <MudTh>批次</MudTh>
                                <MudTh>供应商</MudTh>
                                <MudTh>检验计划</MudTh>
                                <MudTh>抽样</MudTh>
                                <MudTh>不合格</MudTh>
                                <MudTh>判定</MudTh>
                                <MudTh>检验员</MudTh>
                                <MudTh>时间</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="编码">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@context.ProductCode</MudText>
                                </MudTd>
                                <MudTd DataLabel="名称">@context.ProductName</MudTd>
                                <MudTd DataLabel="批次">@(context.BatchNumber ?? "-")</MudTd>
                                <MudTd DataLabel="供应商">@(context.SupplierCode ?? "-")</MudTd>
                                <MudTd DataLabel="计划">@context.InspectionPlanName</MudTd>
                                <MudTd DataLabel="抽样">@context.SampleSize</MudTd>
                                <MudTd DataLabel="不合格">
                                    <MudText Typo="Typo.body2" Color="@(context.DefectCount > 0 ? Color.Error : Color.Success)">
                                        @context.DefectCount
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="判定">
                                    <MudChip T="string" Size="Size.Small" Color="@GetVerdictColor(context.Verdict)" Variant="Variant.Outlined">
                                        @GetVerdictLabel(context.Verdict)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="检验员">@context.InspectorId</MudTd>
                                <MudTd DataLabel="时间">@context.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="操作">
                                    <MudStack Row Spacing="1">
                                        @if (context.Verdict == "Pending")
                                        {
                                            @if (context.Stage == "Iq")
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                           OnClick="() => OpenMeasureDialog(context)">
                                                    录入
                                                </MudButton>
                                            }
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                                       OnClick="() => OpenCompleteDialog(context)">
                                                完成
                                            </MudButton>
                                        }
                                        <MudIconButton Icon="@(IsRecordExpanded(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       OnClick="() => ToggleRecordExpanded(context.Id)"
                                                       Size="Size.Small" Color="Color.Primary" />
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                            <ChildRowContent>
                                @if (IsRecordExpanded(context.Id))
                                {
                                    <MudTr>
                                        <MudTd ColSpan="11" Class="pa-0" Style="border-top:none;">
                                            @if (context.Characteristics.Count == 0)
                                            {
                                                <MudText Typo="Typo.body2" Class="section-copy pa-3">暂无特性实测值（检验尚未记录测量数据）</MudText>
                                            }
                                            else
                                            {
                                                <MudStack Spacing="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Class="kpi-label">
                                                        检验特性（@context.Characteristics.Count 项）
                                                    </MudText>
                                                    <MudTable Items="@context.Characteristics" Dense="true" Elevation="0" Class="detail-table">
                                                        <HeaderContent>
                                                            <MudTh>特性编码</MudTh>
                                                            <MudTh>特性名称</MudTh>
                                                            <MudTh>标准值</MudTh>
                                                            <MudTh>下限 LSL</MudTh>
                                                            <MudTh>上限 USL</MudTh>
                                                            <MudTh>实测值</MudTh>
                                                            <MudTh>判定</MudTh>
                                                        </HeaderContent>
                                                        <RowTemplate Context="mc">
                                                            <MudTd DataLabel="编码">@mc.CharacteristicCode</MudTd>
                                                            <MudTd DataLabel="名称">@mc.CharacteristicName</MudTd>
                                                            <MudTd DataLabel="标准值">@FormatMeasured(mc.StandardValue, mc.Unit)</MudTd>
                                                            <MudTd DataLabel="LSL">@FormatMeasured(mc.LowerSpecLimit, mc.Unit)</MudTd>
                                                            <MudTd DataLabel="USL">@FormatMeasured(mc.UpperSpecLimit, mc.Unit)</MudTd>
                                                            <MudTd DataLabel="实测值">@FormatMeasured(mc.ActualValue, mc.Unit)</MudTd>
                                                            <MudTd DataLabel="判定">
                                                                @if (mc.ActualValue is null)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">待测</MudChip>
                                                                }
                                                                else
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="@(mc.IsFailed ? Color.Error : Color.Success)" Variant="Variant.Outlined">
                                                                        @(mc.IsFailed ? "NG" : "OK")
                                                                    </MudChip>
                                                                }
                                                            </MudTd>
                                                        </RowTemplate>
                                                    </MudTable>
                                                </MudStack>
                                            }
                                        </MudTd>
                                    </MudTr>
                                }
                            </ChildRowContent>
                        </MudTable>
                    }
                </MudStack>

                @* 新建 IQC 来料检验对话框 *@
                <MudDialog @bind-Visible="_showCreateIqcDialog">
                    <DialogContent>
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">新建 IQC 来料检验</MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="物料编码 *" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcMaterialCode" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="物料名称" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcMaterialName" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="批次号 *" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcBatchNumber" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="供应商编码" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcSupplierCode" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="供应商名称" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcSupplierName" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="检验员工号 *" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcInspectorId" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int" Label="抽样数量" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcSampleSize" Min="1" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int" Label="合格判定数 (Ac)" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcAcceptNumber" Min="0" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudNumericField T="int" Label="不合格判定数 (Re)" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_iqcRejectNumber" Min="1" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect T="string" Label="检验计划（可选，默认内置模板）" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Value="_iqcPlanId" ValueChanged="OnIqcPlanChanged" Clearable="true">
                                        @foreach (var plan in _iqcPlanOptions)
                                        {
                                            <MudSelectItem Value="plan.Id">@plan.PlanName @($"v{plan.Version}")（@plan.Characteristics.Count 项特性）</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudText Typo="Typo.caption" Class="kpi-label">未选择时使用内置标准 IQC 模板（8 项特性）。</MudText>
                                </MudItem>
                            </MudGrid>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="CreateIqcAsync" Disabled="_isActionLoading" FullWidth="true">
                                创建检验单
                            </MudButton>
                        </MudStack>
                    </DialogContent>
                </MudDialog>

                @* 新建 IPQC 过程巡检对话框 *@
                <MudDialog @bind-Visible="_showCreateIpqcDialog" FullWidth="true" MaxWidth="MaxWidth.Medium">
                    <DialogContent>
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">新建 IPQC 过程巡检</MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="工单 Id *" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ipqcOrderId" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="工单号" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ipqcOrderNumber" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="检验员工号 *" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ipqcInspectorId" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="产品编码" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ipqcProductCode" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="产品名称" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ipqcProductName" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField Label="检验计划名称" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_ipqcPlanName" Placeholder="如：IPQC 过程巡检计划" />
                                </MudItem>
                            </MudGrid>

                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">检验特性（@_ipqcCharacteristics.Count 项）</MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddIpqcCharacteristic">
                                    添加特性
                                </MudButton>
                            </MudStack>

                            @if (_ipqcCharacteristics.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="section-copy">请至少添加一项检验特性。</MudText>
                            }
                            else
                            {
                                <MudTable Items="@_ipqcCharacteristics" Dense="true" Elevation="0" Class="detail-table">
                                    <HeaderContent>
                                        <MudTh>编码</MudTh>
                                        <MudTh>名称</MudTh>
                                        <MudTh>标准值</MudTh>
                                        <MudTh>单位</MudTh>
                                        <MudTh>下限</MudTh>
                                        <MudTh>上限</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@context.CharacteristicCode" ValueChanged="(string v) => UpdateIpqcChar(context, v, null, null, null, null, null)" /></MudTd>
                                        <MudTd><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@context.CharacteristicName" ValueChanged="(string v) => UpdateIpqcChar(context, null, v, null, null, null, null)" /></MudTd>
                                        <MudTd><MudNumericField T="double" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@context.StandardValue" ValueChanged="(double v) => UpdateIpqcChar(context, null, null, v, null, null, null)" /></MudTd>
                                        <MudTd><MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@context.Unit" ValueChanged="(string v) => UpdateIpqcChar(context, null, null, null, v, null, null)" /></MudTd>
                                        <MudTd><MudNumericField T="double?" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@context.LowerSpecLimit" ValueChanged="(double? v) => UpdateIpqcChar(context, null, null, null, null, v, null)" /></MudTd>
                                        <MudTd><MudNumericField T="double?" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@context.UpperSpecLimit" ValueChanged="(double? v) => UpdateIpqcChar(context, null, null, null, null, null, v)" /></MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="() => RemoveIpqcCharacteristic(context)" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="CreateIpqcAsync" Disabled="_isActionLoading" FullWidth="true">
                                创建巡检单
                            </MudButton>
                        </MudStack>
                    </DialogContent>
                </MudDialog>

                @* 录入实测值对话框 *@
                <MudDialog @bind-Visible="_showMeasureDialog" FullWidth="true" MaxWidth="MaxWidth.Medium">
                    <DialogContent>
                        @if (_measureTarget is not null)
                        {
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6">录入实测值 — @_measureTarget.InspectionPlanName</MudText>
                                <MudText Typo="Typo.caption" Class="kpi-label">
                                    @_measureTarget.ProductCode · 批次 @(_measureTarget.BatchNumber ?? "-") · 检验员 @_measureTarget.InspectorId
                                </MudText>
                                <MudTable Items="@_measureTarget.Characteristics" Dense="true" Elevation="0" Class="detail-table">
                                    <HeaderContent>
                                        <MudTh>特性</MudTh>
                                        <MudTh>标准值</MudTh>
                                        <MudTh>规格</MudTh>
                                        <MudTh>单位</MudTh>
                                        <MudTh>实测值</MudTh>
                                        <MudTh>判定</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="mc">
                                        <MudTd DataLabel="特性">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;">@mc.CharacteristicCode</MudText>
                                            <MudText Typo="Typo.caption" Class="kpi-label">@mc.CharacteristicName</MudText>
                                        </MudTd>
                                        <MudTd DataLabel="标准值">@FormatMeasured(mc.StandardValue, mc.Unit)</MudTd>
                                        <MudTd DataLabel="规格">
                                            @FormatSpec(mc.LowerSpecLimit, mc.UpperSpecLimit, mc.Unit)
                                        </MudTd>
                                        <MudTd DataLabel="单位">@mc.Unit</MudTd>
                                        <MudTd DataLabel="实测值">
                                            @if (mc.ActualValue is null)
                                            {
                                                <MudNumericField T="double" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                 Size="Size.Small" Value="@GetInputValue(mc.CharacteristicCode)"
                                                                 ValueChanged="(double v) => SetInputValue(mc.CharacteristicCode, v)" />
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="@(mc.IsFailed ? Color.Error : Color.Success)">
                                                    @FormatMeasured(mc.ActualValue, mc.Unit)
                                                </MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="判定">
                                            @if (mc.ActualValue is null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">待测</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="@(mc.IsFailed ? Color.Error : Color.Success)" Variant="Variant.Outlined">
                                                    @(mc.IsFailed ? "NG" : "OK")
                                                </MudChip>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveMeasurementsAsync" Disabled="_isActionLoading" FullWidth="true">
                                    保存实测值
                                </MudButton>
                            </MudStack>
                        }
                    </DialogContent>
                </MudDialog>

                @* 完成检验对话框 *@
                <MudDialog @bind-Visible="_showCompleteDialog">
                    <DialogContent>
                        @if (_completeTarget is not null)
                        {
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6">完成检验 — @_completeTarget.InspectionPlanName</MudText>
                                <MudText Typo="Typo.body2" Class="section-copy">
                                    已录入 @(_completeTarget.Characteristics.Count(c => c.ActualValue is not null)) / @_completeTarget.Characteristics.Count 项实测值。
                                    完成后系统自动判定（不合格自动生成 NCR）。
                                </MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Success"
                                           OnClick="CompleteRecordAsync" Disabled="_isActionLoading" FullWidth="true">
                                    完成检验并判定
                                </MudButton>
                            </MudStack>
                        }
                    </DialogContent>
                </MudDialog>
            </MudTabPanel>

            <MudTabPanel Text="NCR 处置看板" Icon="@Icons.Material.Filled.Rule">
                @* ── NCR 内容 ── *@
                <MudStack Spacing="2" Class="pa-4">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadNcrsAsync"
                                   Disabled="_isLoading" StartIcon="@Icons.Material.Filled.Refresh">
                            刷新
                        </MudButton>
                        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small">
                            <MudButton OnClick='() => OnNcrFilterChanged("Open")'
                                       Variant='@(_ncrFilter == "Open" ? Variant.Filled : Variant.Outlined)'
                                       Color='@(_ncrFilter == "Open" ? Color.Warning : Color.Default)'>
                                待处理
                            </MudButton>
                            <MudButton OnClick='() => OnNcrFilterChanged("UnderReview")'
                                       Variant='@(_ncrFilter == "UnderReview" ? Variant.Filled : Variant.Outlined)'>
                                评审中
                            </MudButton>
                            <MudButton OnClick='() => OnNcrFilterChanged("Dispositioned")'
                                       Variant='@(_ncrFilter == "Dispositioned" ? Variant.Filled : Variant.Outlined)'>
                                已处置
                            </MudButton>
                            <MudButton OnClick='() => OnNcrFilterChanged("Closed")'
                                       Variant='@(_ncrFilter == "Closed" ? Variant.Filled : Variant.Outlined)'>
                                已关闭
                            </MudButton>
                        </MudButtonGroup>
                    </MudStack>

                    @if (_isLoading && _ncrs.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Class="section-copy">加载 NCR 列表...</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else if (_ncrs.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                                <MudText Typo="Typo.body1">暂无 @_ncrFilter 状态的 NCR</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else
                    {
                        <div class="inventory-grid">
                            @foreach (var ncr in _ncrs)
                            {
                                <MudPaper Class="glass-kpi-card">
                                    <MudStack Spacing="2">
                                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                                <span class='status-dot @(ncr.Severity == "Critical" ? "alarm" : ncr.Severity == "Major" ? "idle" : "running")'></span>
                                                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@ncr.NcrNumber</MudText>
                                            </MudStack>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color='@(ncr.Severity == "Critical" ? Color.Error : ncr.Severity == "Major" ? Color.Warning : Color.Info)'
                                                     Variant="Variant.Outlined">
                                                @ncr.Severity
                                            </MudChip>
                                        </MudStack>

                                        <MudText Typo="Typo.body2">@ncr.ProductName (@ncr.ProductCode)</MudText>
                                        <MudText Typo="Typo.caption" Class="kpi-label" Style="white-space:pre-wrap;">@ncr.Description</MudText>

                                        <MudStack Row Spacing="4" Justify="Justify.SpaceBetween">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Class="kpi-label">不合格</MudText>
                                                <MudText Typo="Typo.body2" Color="Color.Error">@ncr.DefectQuantity 件</MudText>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Class="kpi-label">发现阶段</MudText>
                                                <MudText Typo="Typo.body2">@ncr.DiscoveredAt</MudText>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Class="kpi-label">发现人</MudText>
                                                <MudText Typo="Typo.body2">@ncr.DiscoveredBy</MudText>
                                            </MudStack>
                                        </MudStack>

                                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                            @if (ncr.Status == "Open")
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                                           OnClick="() => OpenNcrDialog(ncr)">
                                                    提交评审
                                                </MudButton>
                                            }
                                            else if (ncr.Status == "UnderReview")
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                           OnClick="() => OpenNcrDialog(ncr)">
                                                    做出处置
                                                </MudButton>
                                            }
                                            else if (ncr.Status == "Dispositioned")
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                                           OnClick="() => OpenNcrDialog(ncr)">
                                                    关闭
                                                </MudButton>
                                            }
                                            <MudText Typo="Typo.caption" Class="kpi-sub" Style="margin-left:auto;">
                                                @ncr.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </div>
                    }
                </MudStack>

                @* NCR 操作对话框 *@
                <MudDialog @bind-Visible="_showNcrDialog">
                    <DialogContent>
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">@(_showNcrDialog ? _selectedNcr?.NcrNumber : "")</MudText>
                            @if (_selectedNcr is not null)
                            {
                                <MudText Typo="Typo.body2" Class="kpi-label">@_selectedNcr.Description</MudText>

                                @if (_selectedNcr.Status == "Open")
                                {
                                    <MudTextField Label="评审人 (员工号)" Variant="Variant.Outlined"
                                                  @bind-Value="_ncrReviewerId" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                               OnClick="SubmitNcrReviewAsync" Disabled="_isNcrActionLoading"
                                               FullWidth="true">
                                        提交 MRB 评审
                                    </MudButton>
                                }
                                else if (_selectedNcr.Status == "UnderReview")
                                {
                                    <MudSelect T="string" Label="处置方式" Variant="Variant.Outlined"
                                               @bind-Value="_ncrDisposition">
                                        <MudSelectItem Value='@("Concession")'>让步接收</MudSelectItem>
                                        <MudSelectItem Value='@("Rework")'>返工</MudSelectItem>
                                        <MudSelectItem Value='@("Repair")'>返修</MudSelectItem>
                                        <MudSelectItem Value='@("Scrap")'>报废</MudSelectItem>
                                        <MudSelectItem Value='@("ReturnToSupplier")'>退货供应商</MudSelectItem>
                                    </MudSelect>
                                    <MudTextField Label="评审意见" Variant="Variant.Outlined" Lines="3"
                                                  @bind-Value="_ncrComments" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               OnClick="DispositionNcrAsync" Disabled="_isNcrActionLoading"
                                               FullWidth="true">
                                        确认处置
                                    </MudButton>
                                }
                                else if (_selectedNcr.Status == "Dispositioned")
                                {
                                    <MudText Typo="Typo.body2">
                                        处置方式：<strong>@_selectedNcr.Disposition</strong>
                                    </MudText>
                                    <MudTextField Label="关闭备注" Variant="Variant.Outlined" Lines="2"
                                                  @bind-Value="_ncrCloseRemarks" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                                               OnClick="CloseNcrAsync" Disabled="_isNcrActionLoading"
                                               FullWidth="true">
                                        关闭 NCR
                                    </MudButton>
                                }
                            }
                        </MudStack>
                    </DialogContent>
                </MudDialog>
            </MudTabPanel>

            <MudTabPanel Text="8D 报告" Icon="@Icons.Material.Filled.Assignment">
                @* ── 8D 内容 ── *@
                <MudStack Spacing="2" Class="pa-4">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="() => _showCreateEightDDialog = true">
                            新建 8D
                        </MudButton>
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudButton OnClick='() => OnEightDFilterChanged("Open")'
                                       Variant='@(_eightDFilter == "Open" ? Variant.Filled : Variant.Outlined)'>
                                进行中
                            </MudButton>
                            <MudButton OnClick='() => OnEightDFilterChanged("Closed")'
                                       Variant='@(_eightDFilter == "Closed" ? Variant.Filled : Variant.Outlined)'>
                                已关闭
                            </MudButton>
                        </MudButtonGroup>
                    </MudStack>

                    @if (_isLoading && _eightDReports.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudProgressCircular Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Class="section-copy">加载 8D 报告列表...</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else if (_eightDReports.Count == 0)
                    {
                        <MudPaper Class="glass-kpi-card pa-8">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.body1">暂无 @_eightDFilter 状态的 8D 报告</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                    else
                    {
                        <MudTable Items="@_eightDReports" Dense="true" Hover="true" Striped="true"
                                  Elevation="0" Class="module-card">
                            <HeaderContent>
                                <MudTh>编号</MudTh>
                                <MudTh>问题标题</MudTh>
                                <MudTh>产品</MudTh>
                                <MudTh>状态</MudTh>
                                <MudTh>负责人</MudTh>
                                <MudTh>创建时间</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="编号">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@context.ReportNumber</MudText>
                                </MudTd>
                                <MudTd DataLabel="问题" Style="max-width:250px; overflow:hidden; text-overflow:ellipsis;">@context.Title</MudTd>
                                <MudTd DataLabel="产品">@context.ProductCode</MudTd>
                                <MudTd DataLabel="状态">
                                    <MudChip T="string" Size="Size.Small"
                                             Color='@(context.Status == "Closed" ? Color.Success : Color.Warning)'
                                             Variant="Variant.Outlined">
                                        @(context.Status == "Closed" ? "已关闭" : "进行中")
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="负责人">@(context.TeamLeader ?? "-")</MudTd>
                                <MudTd DataLabel="创建时间">@context.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="操作">
                                    <MudStack Row Spacing="1">
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   OnClick="() => OpenEightDDialog(context)">
                                            查看
                                        </MudButton>
                                        @if (context.Status != "Closed")
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info"
                                                       OnClick="() => OpenEightDEditDialog(context)">
                                                编辑
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                                       OnClick="() => OpenEightDDialog(context)">
                                                关闭
                                            </MudButton>
                                        }
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>

                @* 新建 8D 对话框 *@
                <MudDialog @bind-Visible="_showCreateEightDDialog">
                    <DialogContent>
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">新建 8D 问题解决报告</MudText>
                            <MudTextField Label="问题标题" Variant="Variant.Outlined" @bind-Value="_newEightDTitle" />
                            <MudTextField Label="产品编码" Variant="Variant.Outlined" @bind-Value="_newEightDProductCode" />
                            <MudTextField Label="产品名称" Variant="Variant.Outlined" @bind-Value="_newEightDProductName" />
                            <MudTextField Label="关联 NCR Id（可选）" Variant="Variant.Outlined" @bind-Value="_newEightDNcrId" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="CreateEightDAsync" Disabled="_isLoading"
                                       FullWidth="true">
                                创建
                            </MudButton>
                        </MudStack>
                    </DialogContent>
                </MudDialog>

                @* 8D 查看/关闭对话框 *@
                <MudDialog @bind-Visible="_showEightDDialog">
                    <DialogContent>
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">@(_showEightDDialog ? _selectedEightD?.ReportNumber : "")</MudText>
                            @if (_selectedEightD is not null)
                            {
                                <MudText Typo="Typo.subtitle2">@_selectedEightD.Title</MudText>

                                @if (_selectedEightD.Status == "Closed")
                                {
                                    <MudText Typo="Typo.body2" Class="kpi-label">
                                        关闭时间：@(_selectedEightD.ClosedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                                    </MudText>
                                }
                                else
                                {
                                    <MudTextField Label="总结 (D8)" Variant="Variant.Outlined" Lines="3"
                                                  @bind-Value="_eightDSummary" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                                               OnClick="CloseEightDAsync" Disabled="_isLoading"
                                               FullWidth="true">
                                        关闭 8D 报告
                                    </MudButton>
                                }
                            }
                        </MudStack>
                    </DialogContent>
                </MudDialog>

                @* 8D 编辑对话框（D1-D7） *@
                <MudDialog @bind-Visible="_showEightDEditDialog" FullWidth="true" MaxWidth="MaxWidth.Medium">
                    <DialogContent>
                        @if (_editEightD is not null)
                        {
                            <MudStack Spacing="3">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.h6">编辑 8D — @_editEightD.ReportNumber</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                        D1-D7 步骤
                                    </MudChip>
                                </MudStack>

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D1 团队</MudText>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField Label="团队负责人" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editTeamLeader" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField Label="团队成员" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editTeamMembers" Placeholder="逗号分隔" />
                                    </MudItem>
                                </MudGrid>

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D2 问题描述</MudText>
                                <MudTextField Label="问题描述" Variant="Variant.Outlined" Lines="2" @bind-Value="_editProblemDescription" />

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D3 围堵措施</MudText>
                                <MudTextField Label="围堵措施" Variant="Variant.Outlined" Lines="2" @bind-Value="_editContainmentAction" />

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D4 根本原因</MudText>
                                <MudTextField Label="根因分析" Variant="Variant.Outlined" Lines="2" @bind-Value="_editRootCauseAnalysis" />
                                <MudTextField Label="根因结论" Variant="Variant.Outlined" Lines="2" @bind-Value="_editRootCause" />

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D5 纠正措施</MudText>
                                <MudTextField Label="纠正措施" Variant="Variant.Outlined" Lines="2" @bind-Value="_editCorrectiveAction" />
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField Label="责任人" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_editCorrectiveActionOwner" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Label="完成期限" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="_editDueDate" />
                                    </MudItem>
                                </MudGrid>

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D6 效果验证</MudText>
                                <MudTextField Label="验证方法" Variant="Variant.Outlined" Lines="2" @bind-Value="_editVerificationMethod" />
                                <MudTextField Label="验证结果" Variant="Variant.Outlined" Lines="2" @bind-Value="_editVerificationResult" />

                                <MudText Typo="Typo.subtitle2" Class="section-kicker">D7 预防措施</MudText>
                                <MudTextField Label="预防措施" Variant="Variant.Outlined" Lines="2" @bind-Value="_editPreventiveAction" />

                                <MudNumericField T="int" Label="已完成步骤 (1-7)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 @bind-Value="_editCompletedStep" Min="0" Max="7" />

                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveEightDAsync" Disabled="_isActionLoading" FullWidth="true">
                                    保存 D1-D7
                                </MudButton>
                            </MudStack>
                        }
                    </DialogContent>
                </MudDialog>
            </MudTabPanel>

            <MudTabPanel Text="质量概览" Icon="@Icons.Material.Filled.Insights">
                @* ── 概览内容 ── *@
                <MudStack Spacing="2" Class="pa-4">
                    <div class="oee-grid">
                        <MudPaper Class="glass-kpi-card">
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Large"
                                         Color="@(_activeAlertCount > 0 ? Color.Warning : Color.Success)" />
                                <MudText Typo="Typo.h3" Color="@(_activeAlertCount > 0 ? Color.Warning : Color.Success)">
                                    @_activeAlertCount
                                </MudText>
                                <MudText Typo="Typo.body2" Class="kpi-label">未确认告警</MudText>
                            </MudStack>
                        </MudPaper>

                        <MudPaper Class="glass-kpi-card">
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.BugReport" Size="Size.Large" Color="Color.Error" />
                                <MudText Typo="Typo.h3" Color="Color.Error">
                                    @_ncrs.Count(n => n.Status != "Closed")
                                </MudText>
                                <MudText Typo="Typo.body2" Class="kpi-label">未关闭 NCR</MudText>
                            </MudStack>
                        </MudPaper>

                        <MudPaper Class="glass-kpi-card">
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" />
