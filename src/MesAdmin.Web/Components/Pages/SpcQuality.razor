        => _ipqcCharacteristics.Remove(row);

    private void UpdateIpqcChar(IpqcCharRow row, string? code, string? name, double? standard, string? unit, double? lsl, double? usl)
    {
        if (code is not null) row.CharacteristicCode = code;
        if (name is not null) row.CharacteristicName = name;
        if (standard is not null) row.StandardValue = standard.Value;
        if (unit is not null) row.Unit = unit;
        if (lsl is not null) row.LowerSpecLimit = lsl;
        if (usl is not null) row.UpperSpecLimit = usl;
    }

    private async Task CreateIpqcAsync()
    {
        if (string.IsNullOrWhiteSpace(_ipqcOrderId) || string.IsNullOrWhiteSpace(_ipqcInspectorId) ||
            _ipqcCharacteristics.Count == 0)
            return;
        _isActionLoading = true;
        try
        {
            var chars = _ipqcCharacteristics
                .Where(c => !string.IsNullOrWhiteSpace(c.CharacteristicCode))
                .Select(c => new MeasuredCharacteristicBody(
                    c.CharacteristicCode, c.CharacteristicName, c.StandardValue,
                    c.UpperSpecLimit, c.LowerSpecLimit, c.Unit))
                .ToList();
            if (chars.Count == 0) return;

            var (ok, _, _) = await Api.CreateIpqcAsync(new CreateIpqcBody(
                _ipqcOrderId, _ipqcOrderNumber, _ipqcProductCode, _ipqcProductName,
                "", _ipqcPlanName, _ipqcInspectorId, 0, 1, chars));
            if (ok)
            {
                _showCreateIpqcDialog = false;
                await LoadQualityRecordsAsync();
            }
        }
        finally
