        {
            PageLogger.LogError(ex, "加载检验记录失败");
            _errorMessage = $"加载检验记录失败：{ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRecordStageChanged(string stage)
    {
        _recordStage = stage;
        await LoadQualityRecordsAsync();
    }

    private bool IsRecordExpanded(string id) => _expandedRecordIds.Contains(id);

    private void ToggleRecordExpanded(string id)
    {
        if (!_expandedRecordIds.Add(id))
            _expandedRecordIds.Remove(id);
    }

    private static string FormatMeasured(double? value, string unit)
    {
        if (value is null) return "-";
        var v = value.Value.ToString("0.##");
        return string.IsNullOrWhiteSpace(unit) ? v : $"{v} {unit}";
    }

    private static string GetStageLabel(string stage) => stage switch
    {
        "Iq" => "IQC 来料检验",
        "Ipqc" => "IPQC 过程巡检",
        "Oqc" => "OQC 出货检验",
        "FirstArticle" => "首件检验",
        "OnlineTest" => "在线功能测试",
        _ => stage
    };

    private static string GetVerdictLabel(string verdict) => verdict switch
    {
        "Passed" => "合格",
        "Failed" => "不合格",
        "ConditionalPass" => "让步接收",
        _ => "待判定"
    };

    private static Color GetVerdictColor(string verdict) => verdict switch
    {
        "Passed" => Color.Success,
        "Failed" => Color.Error,
        "ConditionalPass" => Color.Warning,
        _ => Color.Default
    };

