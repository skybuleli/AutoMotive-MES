@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>仪表盘 — AutoMES</PageTitle>

<MudStack Spacing="4" Class="home-page">

    <!-- 页头 -->
    <MesPageHeader Kicker="OVERVIEW · 总览与告警"
                   Title="博世 ESP® 制动系统 MES"
                   TitleClass="text-gradient"
                   Description="汽车安全件 Tier-1 供应商全链路制造执行系统 · 7 站 31 工序" />

    <!-- KPI 卡片 -->
    <MudGrid Spacing="4">
        @foreach (var kpi in _kpis)
        {
            <MudItem xs="12" sm="6" md="3">
                <MesKpiCard Label="@kpi.Label" Value="@kpi.Value" Sub="@kpi.Sub"
                            Icon="@kpi.Icon" Accent="@kpi.Accent" />
            </MudItem>
        }
    </MudGrid>

    <!-- 快速操作 -->
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6" Style="font-weight:600;">快速操作</MudText>
        <MudGrid Spacing="3">
            @foreach (var act in _actions)
            {
                <MudItem xs="6" sm="3">
                    <MudButton Href="@act.Href" Variant="Variant.Outlined" Color="@act.Color"
                               FullWidth StartIcon="@act.Icon" Class="home-action">
                        @act.Label
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudStack>

</MudStack>

@code {
    private readonly (string Label, string Value, string Sub, string Icon, MesAccent Accent)[] _kpis =
    [
        ("OEE", "85.2%", "全局设备综合效率", Icons.Material.Filled.Speed, MesAccent.Primary),
        ("合格率", "97.5%", "一次合格率", Icons.Material.Filled.Verified, MesAccent.Success),
        ("在产工单", "12", "进行中工单数", Icons.Material.Filled.Assignment, MesAccent.Warning),
        ("Andon 报警", "3", "未处理报警", Icons.Material.Filled.NotificationImportant, MesAccent.Error),
    ];

    private readonly (string Label, string Href, Color Color, string Icon)[] _actions =
    [
        ("新建工单", "production", Color.Primary, Icons.Material.Filled.AddCircle),
        ("扫码入库", "material", Color.Success, Icons.Material.Filled.QrCodeScanner),
        ("触发 Andon", "andon", Color.Error, Icons.Material.Filled.Campaign),
        ("追溯查询", "traceability", Color.Warning, Icons.Material.Filled.Search),
    ];
}
