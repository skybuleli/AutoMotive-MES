@page "/Error"
@using System.Diagnostics

<PageTitle>请求异常 - AutoMES</PageTitle>

<div class="d-flex align-center justify-center" style="min-height: 70vh;">
    <MudPaper Elevation="0" Class="module-card pa-8" Style="max-width: 560px; text-align: center;">
        <MudStack Spacing="3" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h4">处理请求时发生错误</MudText>
            @if (ShowRequestId)
            {
                <MudText Typo="Typo.body2" Class="section-copy">
                    Request ID: <code style="font-family: var(--mes-mono);">@RequestId</code>
                </MudText>
            }
            <MudDivider Class="my-2" Style="width: 60%;" />
            <MudText Typo="Typo.body2" Class="section-copy">
                开发环境（Development）将显示异常的详细信息；
                生产环境不应启用，以免向最终用户暴露敏感信息。
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/">
                <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" Class="mr-1" /> 返回首页
            </MudButton>
        </MudStack>
    </MudPaper>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
