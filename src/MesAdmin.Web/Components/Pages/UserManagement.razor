@page "/users"
@attribute [StreamRendering]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ProductionManager")]
@using MesAdmin.Web.Services
@inject MesApiClient Api
@implements IDisposable

<PageTitle>用户管理 - AutoMES</PageTitle>

<MudStack Spacing="2">
    <MesPageHeader Kicker="SYS · User Management" Title="用户管理">
        <HeaderActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="@(() => OpenEditDialog(null))">
                新建用户
            </MudButton>
        </HeaderActions>
    </MesPageHeader>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense>@_error</MudAlert>
    }

    <MudPaper Class="pa-4">
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <MudTextField T="string" @bind-Value="_keyword" Placeholder="搜索用户名 / 姓名"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small" Style="max-width:320px;" />
            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" OnClick="LoadAsync" />
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="section-copy">共 @_users.Count 个账号</MudText>
        </MudStack>

        @if (_loading)
        {
            <MesStateCard Loading="true" Text="加载用户列表..." />
        }
        else
        {
            <MudTable Items="@_users" Hover="true" Dense="true" Loading="@_loading">
                <HeaderContent>
                    <MudTh>用户名</MudTh>
                    <MudTh>姓名</MudTh>
                    <MudTh>角色</MudTh>
                    <MudTh>状态</MudTh>
                    <MudTh>最后登录</MudTh>
                    <MudTh>创建时间</MudTh>
                    <MudTh Style="text-align:right;">操作</MudTh>
                </HeaderContent>
                <RowTemplate Context="user">
                    <MudTd DataLabel="用户名" Class="@(user.IsActive ? "" : "oee-grade-b")">
                        <span style="font-family:var(--mes-mono);">@user.Username</span>
                    </MudTd>
                    <MudTd DataLabel="姓名">@user.DisplayName</MudTd>
                    <MudTd DataLabel="角色">
                        <MudStack Row Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var role in user.Roles)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@RoleColor(role)">
                                    @RoleName(role)
                                </MudChip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="状态">
                        @if (!user.IsActive)
                        {
                            <MudTooltip Text="已停用">
                                <ActivatorContent>
                                    <MesStatusDot Status="MesDotStatus.Offline" />
                                </ActivatorContent>
                            </MudTooltip>
                        }
                        else if (user.IsLockedOut)
                        {
                            <MudTooltip Text="登录锁定中">
                                <ActivatorContent>
                                    <MesStatusDot Status="MesDotStatus.Alarm" />
                                </ActivatorContent>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="正常">
                                <ActivatorContent>
                                    <MesStatusDot Status="MesDotStatus.Running" />
                                </ActivatorContent>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="最后登录" Class="section-copy">
                        @user.LastLoginAt?.ToLocalTime().ToString("MM-dd HH:mm")
                    </MudTd>
                    <MudTd DataLabel="创建时间" Class="section-copy">
                        @user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </MudTd>
                    <MudTd Style="text-align:right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                       OnClick="@(() => OpenEditDialog(user))" />
                        <MudIconButton Icon="@Icons.Material.Filled.LockReset" Size="Size.Small" Color="Color.Warning"
                                       OnClick="@(() => OpenResetDialog(user))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudStack>

<MudDialog @bind-Visible="_showEditDialog" FullWidth="true" MaxWidth="MaxWidth.Small">
    <DialogContent>
        <MudStack Spacing="2">
            @if (_editError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense>@_editError</MudAlert>
            }
            <MudTextField T="string" Label="用户名" @bind-Value="_editUsername"
                          Disabled="@(!_isCreate)" Required="true"
                          HelperText="@(_isCreate ? "小写字母/数字/下划线/连字符" : "用户名不可修改")" />
            <MudTextField T="string" Label="姓名" @bind-Value="_editDisplayName" Required="true" />
            @if (_isCreate)
            {
                <MudTextField T="string" Label="初始密码" @bind-Value="_editPassword"
                              InputType="InputType.Password" Required="true"
                              HelperText="≥8 位，须包含字母和数字" />
            }
            <MudText Typo="Typo.caption" Class="section-copy">角色</MudText>
            <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                @foreach (var (key, label) in AllRoles)
                {
                    var selected = _editRoles.Contains(key);
                    <MudChip T="string" Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                             Color="@(selected ? Color.Primary : Color.Default)"
                             Size="Size.Small" OnClick="@(() => ToggleRole(key))">
                        @label
                    </MudChip>
                }
            </MudStack>
            @if (!_isCreate)
            {
                <MudSwitch T="bool" Label="启用账号" @bind-Value="_editIsActive" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _showEditDialog = false)">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Loading="_saving" OnClick="SaveEditAsync">
            @(_isCreate ? "创建" : "保存")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showResetDialog" MaxWidth="MaxWidth.Tiny">
    <DialogContent>
        <MudStack Spacing="2">
            <MudText>为 <b>@_resetTargetName</b> 设置新密码：</MudText>
            @if (_resetError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense>@_resetError</MudAlert>
            }
            <MudTextField T="string" Label="新密码" @bind-Value="_newPassword"
                          InputType="InputType.Password" Required="true"
                          HelperText="≥8 位，须包含字母和数字" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _showResetDialog = false)">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Loading="_saving" OnClick="ConfirmResetAsync">
            重置
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private string? _error;
    private string _keyword = string.Empty;
    private List<UserDto> _users = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _users = await Api.GetUsersAsync(_keyword) ?? [];
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"加载失败：{ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string RoleName(string role) => role switch
    {
        "ProductionManager" => "生产经理",
        "ShiftLeader" => "班组长",
        "QualityEngineer" => "质量工程师",
        "EquipmentEngineer" => "设备工程师",
        "WarehouseClerk" => "仓库员",
        "SupplierQualityEngineer" => "SQE",
        "Inspector" => "质检员",
        "Technician" => "技术员",
        _ => role,
    };

    private static Color RoleColor(string role) => role switch
    {
        "ProductionManager" => Color.Primary,
        "QualityEngineer" or "SupplierQualityEngineer" => Color.Success,
        "EquipmentEngineer" => Color.Warning,
        _ => Color.Info,
    };

    public void Dispose() { }

    // ── 新建/编辑对话框（内联，项目约定 @bind-Visible 模式）──

    private bool _showEditDialog;
    private bool _isCreate;
    private string _editId = string.Empty;
    private string _editUsername = string.Empty;
    private string _editDisplayName = string.Empty;
    private string[] _editRoles = [];
    private bool _editIsActive = true;
    private string _editPassword = string.Empty;
    private string? _editError;
    private bool _saving;

    private static readonly (string Key, string Label)[] AllRoles =
    [
        ("ProductionManager", "生产经理"),
        ("ShiftLeader", "班组长"),
        ("QualityEngineer", "质量工程师"),
        ("EquipmentEngineer", "设备工程师"),
        ("WarehouseClerk", "仓库员"),
        ("SupplierQualityEngineer", "SQE"),
        ("Inspector", "质检员"),
        ("Technician", "技术员"),
    ];

    private void OpenEditDialog(UserDto? user)
    {
        _isCreate = user is null;
        _editId = user?.Id ?? string.Empty;
        _editUsername = user?.Username ?? string.Empty;
        _editDisplayName = user?.DisplayName ?? string.Empty;
        _editRoles = user?.Roles ?? [];
        _editIsActive = user?.IsActive ?? true;
        _editPassword = string.Empty;
        _editError = null;
        _showEditDialog = true;
    }

    private void ToggleRole(string key)
    {
        _editRoles = _editRoles.Contains(key)
            ? _editRoles.Where(r => r != key).ToArray()
            : [.. _editRoles, key];
    }

    private async Task SaveEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_editDisplayName) || _editRoles.Length == 0)
        {
            _editError = "姓名必填且至少选择一个角色";
            return;
        }

        if (_isCreate && NewPasswordInvalid(_editPassword, out var pwdReason))
        {
            _editError = pwdReason;
            return;
        }

        _saving = true;
        try
        {
            var (ok, _, status) = _isCreate
                ? await Api.CreateUserAsync(_editUsername, _editDisplayName, _editPassword, _editRoles)
                : await Api.UpdateUserAsync(_editId, _editDisplayName, _editRoles, _editIsActive);

            if (!ok)
            {
                _editError = status == 409 ? "用户名已存在" : $"保存失败（HTTP {status}）";
                return;
            }
            _showEditDialog = false;
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    // ── 重置密码对话框 ──

    private bool _showResetDialog;
    private string _resetTargetName = string.Empty;
    private string _resetTargetId = string.Empty;
    private string _newPassword = string.Empty;
    private string? _resetError;

    private void OpenResetDialog(UserDto user)
    {
        _resetTargetId = user.Id;
        _resetTargetName = $"{user.Username}（{user.DisplayName}）";
        _newPassword = string.Empty;
        _resetError = null;
        _showResetDialog = true;
    }

    private async Task ConfirmResetAsync()
    {
        if (NewPasswordInvalid(_newPassword, out var reason))
        {
            _resetError = reason;
            return;
        }

        _saving = true;
        try
        {
            var (ok, _, status) = await Api.ResetUserPasswordAsync(_resetTargetId, _newPassword);
            if (!ok)
            {
                _resetError = $"重置失败（HTTP {status}）";
                return;
            }
            _showResetDialog = false;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>密码策略：≥8 位且同时含字母与数字（与 Api 端校验一致）。</summary>
    private static bool NewPasswordInvalid(string password, out string reason)
    {
        reason = password.Length < 8 ? "密码至少 8 位"
            : !password.Any(char.IsLetter) ? "密码须包含字母"
            : !password.Any(char.IsDigit) ? "密码须包含数字"
            : string.Empty;
        return reason != string.Empty;
    }
}
