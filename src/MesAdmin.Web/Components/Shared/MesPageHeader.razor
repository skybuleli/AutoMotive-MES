@* 全站统一页头：kicker 小标 + 标题 + 描述 + 右侧操作区（HeaderActions）。 *@
<MudPaper Class="mes-toolbar pa-5" Role="banner">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
        <MudStack Spacing="1" Class="mes-page-heading">
            @if (!string.IsNullOrEmpty(Kicker))
            {
                <MudText Typo="Typo.overline" Class="section-kicker">@Kicker</MudText>
            }
            <MudText Typo="Typo.h4" Class="@($"mes-page-title {TitleClass}")">@Title</MudText>
            @if (!string.IsNullOrEmpty(Description))
            {
                <MudText Typo="Typo.body1" Class="section-copy mes-page-description">@Description</MudText>
            }
        </MudStack>
        @if (HeaderActions is not null)
        {
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mes-page-actions">
                @HeaderActions
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>标题附加类（如首页的 text-gradient）。</summary>
    [Parameter] public string? TitleClass { get; set; }

    [Parameter] public string? Kicker { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter] public RenderFragment? HeaderActions { get; set; }
}
