@* 全站统一页头（紧凑版）：第一行 = 面包屑 + 右侧操作区（HeaderActions）；
   第二行 = kicker 小标 + 标题 + 描述。相比旧版压缩垂直高度并引入导航层级。 *@
<MudPaper Class="mes-toolbar mes-page-head" Role="banner">
    <div class="mes-page-head-crumb">
        <MesBreadcrumb />
        @if (HeaderActions is not null)
        {
            <div class="mes-page-actions">@HeaderActions</div>
        }
    </div>
    <div class="mes-page-head-title">
        @if (!string.IsNullOrEmpty(Kicker))
        {
            <span class="section-kicker">@Kicker</span>
        }
        <MudText Typo="Typo.h6" Class="@($"mes-page-title {TitleClass}")">@Title</MudText>
        @if (!string.IsNullOrEmpty(Description))
        {
            <span class="mes-page-desc" title="@Description">@Description</span>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>标题附加类（如首页的 text-gradient）。</summary>
    [Parameter] public string? TitleClass { get; set; }

    [Parameter] public string? Kicker { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter] public RenderFragment? HeaderActions { get; set; }
}