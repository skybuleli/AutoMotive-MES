@* 全站统一加载/空态卡片：Loading=true 显示进度环，否则显示图标；ChildContent 放操作按钮。 *@
<MudPaper Class="glass-kpi-card pa-8 mes-state-card" Role="status" aria-live="polite">
    <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="pa-2">
        @if (Loading)
        {
            <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" />
        }
        <MudText Typo="Typo.body1">@Text</MudText>
        @if (!string.IsNullOrEmpty(Hint))
        {
            <MudText Typo="Typo.caption" Class="section-copy">@Hint</MudText>
        }
        @ChildContent
    </MudStack>
</MudPaper>

@code {
    [Parameter] public bool Loading { get; set; } = true;

    [Parameter] public string Text { get; set; } = "加载中...";

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
