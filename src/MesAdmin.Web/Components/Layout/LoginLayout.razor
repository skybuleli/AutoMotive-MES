@using MesAdmin.Web.Services
@using MesAdmin.Web.Themes
@inherits LayoutComponentBase
@inject ThemeService Theme

@* 登录专用布局：无 AppBar / Drawer，全屏居中。
   MudBlazor 全局 Provider 必须保留，否则 MudTextField 等组件无法正常工作。 *@
<MudThemeProvider Theme="MesTheme.CurrentTheme" IsDarkMode="@Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="login-layout">
    @Body
</div>

@code {
    /// <summary>
    /// 登录页无 AppBar/主题按钮，必须在电路就绪后恢复用户偏好，
    /// 否则 MudThemeProvider 恒为暗色调色板，与 CSS 亮色令牌不一致。
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            StateHasChanged();
        }
    }
}
