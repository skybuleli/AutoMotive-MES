@* 全站唯一导航源：按业务域分组，覆盖全部 19 个路由。 *@
<MudNavMenu Class="px-3">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        仪表盘
    </MudNavLink>
    <MudNavLink Href="dashboard" Icon="@Icons.Material.Filled.SpaceDashboard">
        生产看板
    </MudNavLink>

    <MudNavGroup Title="生产执行" Icon="@Icons.Material.Filled.Description" Expanded>
        <MudNavLink Href="production" Icon="@Icons.Material.Filled.ListAlt">
            工单列表
        </MudNavLink>
        <MudNavLink Href="production/kanban" Icon="@Icons.Material.Filled.ViewKanban">
            工单看板
        </MudNavLink>
        <MudNavLink Href="kit-check" Icon="@Icons.Material.Filled.FactCheck">
            齐套检查
        </MudNavLink>
        <MudNavLink Href="start-production" Icon="@Icons.Material.Filled.PlayArrow">
            开工管理
        </MudNavLink>
        <MudNavLink Href="quality-review" Icon="@Icons.Material.Filled.Verified">
            完工审核
        </MudNavLink>
        <MudNavLink Href="scheduling" Icon="@Icons.Material.Filled.Schedule">
            生产排程
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="质量管理" Icon="@Icons.Material.Filled.Analytics">
        <MudNavLink Href="first-article" Icon="@Icons.Material.Filled.FactCheck">
            首件检验
        </MudNavLink>
        @* 检验计划/SPC 端点仅开放给质量/检验/工艺角色，按角色显示避免进入后 403 *@
        <AuthorizeView Roles="QualityEngineer,Inspector">
            <Authorized>
                <MudNavLink Href="inspection-plans" Icon="@Icons.Material.Filled.ListAlt">
                    检验计划
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="QualityEngineer,Technician">
            <Authorized>
                <MudNavLink Href="spc" Icon="@Icons.Material.Filled.QueryStats">
                    SPC 质量管理
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="sqe" Icon="@Icons.Material.Filled.Business">
            SQE 供应商质量
        </MudNavLink>
        @* 计量器具端点开放给质量/设备角色，其余只读角色亦可查看台账 *@
        <AuthorizeView Roles="QualityEngineer,EquipmentEngineer,ProductionManager,Inspector,Technician,ShiftLeader">
            <Authorized>
                <MudNavLink Href="gauges" Icon="@Icons.Material.Filled.Straighten">
                    计量器具台账
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="quality-reports" Icon="@Icons.Material.Filled.Description">
            质量报表
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="物料与追溯" Icon="@Icons.Material.Filled.Inventory2">
        <MudNavLink Href="material" Icon="@Icons.Material.Filled.Inventory">
            物料管理
        </MudNavLink>
        <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.LocalGroceryStore">
            线边库存
        </MudNavLink>
        @* JIT 端点仅开放给生产/仓储角色，按角色显示避免进入后 403 *@
        <AuthorizeView Roles="ProductionManager,ShiftLeader,WarehouseClerk">
            <Authorized>
                <MudNavLink Href="jit-kanban" Icon="@Icons.Material.Filled.LocalShipping">
                    JIT 看板
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="traceability" Icon="@Icons.Material.Filled.Link">
            全链路追溯
        </MudNavLink>
        <MudNavLink Href="sync-monitor" Icon="@Icons.Material.Filled.Sync">
            同步监控
        </MudNavLink>
        <MudNavLink Href="spare-parts" Icon="@Icons.Material.Filled.Handyman">
            备件管理
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="设备与报警" Icon="@Icons.Material.Filled.PrecisionManufacturing">
        <MudNavLink Href="oee" Icon="@Icons.Material.Filled.Timeline">
            设备 OEE
        </MudNavLink>
        <MudNavLink Href="maintenance" Icon="@Icons.Material.Filled.Build">
            预防性维护
        </MudNavLink>
        @* 液压测试端点仅开放给质量/检验/工艺角色，按角色显示避免进入后 403 *@
        <AuthorizeView Roles="QualityEngineer,Inspector,Technician">
            <Authorized>
                <MudNavLink Href="hydraulic-test" Icon="@Icons.Material.Filled.Speed">
                    液压测试台
                </MudNavLink>
            </Authorized>
        </AuthorizeView>
        <MudNavLink Href="andon" Icon="@Icons.Material.Filled.Campaign">
            Andon 报警
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="基础数据" Icon="@Icons.Material.Filled.Schema">
        <MudNavLink Href="routing" Icon="@Icons.Material.Filled.Route">
            工艺管理
        </MudNavLink>
    </MudNavGroup>

    <AuthorizeView Roles="ProductionManager">
        <MudNavGroup Title="系统管理" Icon="@Icons.Material.Filled.AdminPanelSettings">
            <MudNavLink Href="users" Icon="@Icons.Material.Filled.People">
                用户管理
            </MudNavLink>
            <MudNavLink Href="audit-logs" Icon="@Icons.Material.Filled.ReceiptLong">
                审计日志
            </MudNavLink>
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>
