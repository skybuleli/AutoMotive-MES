@using MesAdmin.Web.Services
@using MesAdmin.Web.Themes
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject MesApiClient Api
@inject AuthService Auth
@inject ThemeService Theme
@inject ISnackbar Snack

<MudThemeProvider Theme="MesTheme.CurrentTheme" IsDarkMode="@Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Class="mes-appbar" Dense>
        <MudTooltip Text="展开/收起导航">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           AriaLabel="展开或收起导航"
                           OnClick="ToggleDrawer" />
        </MudTooltip>

        <MudStack Spacing="0" Class="ml-1">
            <MudText Typo="Typo.h6" Class="text-gradient" Style="font-weight:800;letter-spacing:-0.02em;">AutoMES</MudText>
            <MudText Typo="Typo.caption" Class="layout-subtitle">@GetPageTitle()</MudText>
        </MudStack>

        <MudSpacer />

        <LiveClock />

        <AuthorizeView>
            <Authorized>
                <MudTooltip Text="@ThemeToggleText">
                    <MudIconButton Icon="@ThemeToggleIcon"
                                   Color="Color.Inherit"
                                   AriaLabel="@ThemeToggleLabel"
                                   OnClick="ToggleThemeAsync" />
                </MudTooltip>

                <MudTooltip Text="查看现场报警">
                    <MudBadge Content="@("!")" Color="Color.Error" Overlap="true">
                        <MudIconButton Icon="@Icons.Material.Filled.NotificationsActive"
                                       Color="Color.Inherit"
                                       AriaLabel="查看现场报警"
                                       Href="/andon" />
                    </MudBadge>
                </MudTooltip>

                <MudMenu Icon="@Icons.Material.Filled.AddCircleOutline"
                         Color="Color.Inherit"
                         AriaLabel="打开快捷操作"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem Href="/production" Icon="@Icons.Material.Filled.Assignment">工单管理</MudMenuItem>
                    <MudMenuItem Href="/kit-check" Icon="@Icons.Material.Filled.FactCheck">齐套检查</MudMenuItem>
                    <MudMenuItem Href="/start-production" Icon="@Icons.Material.Filled.PlayArrow">开工管理</MudMenuItem>
                    <MudMenuItem Href="/traceability" Icon="@Icons.Material.Filled.Search">追溯查询</MudMenuItem>
                </MudMenu>

                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="mes-user-action" OnClick="LogoutAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-1" />
                    退出
                </MudButton>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         AriaLabel="用户菜单"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Lock" OnClick="OpenChangePasswordDialog">修改密码</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudTooltip Text="@ThemeToggleLabel">
                    <MudIconButton Icon="@ThemeToggleIcon"
                                   Color="Color.Inherit"
                                   AriaLabel="@ThemeToggleLabel"
                                   OnClick="ToggleThemeAsync" />
                </MudTooltip>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="ms-2" OnClick="GoLogin">
                    登录
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Class="mes-drawer">
        <MudDrawerHeader Class="px-4 py-4">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                <div class="mes-brand-mark">
                    <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Style="color:var(--mes-bg);" />
                </div>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">生产执行中台</MudText>
                    <MudText Typo="Typo.caption" Class="layout-subtitle">ESP 总成工厂 · Tier-1</MudText>
                </MudStack>
            </MudStack>
        </MudDrawerHeader>

        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="mes-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-3 mes-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<MudDialog @bind-Visible="_showChangePasswordDialog" MaxWidth="MaxWidth.Tiny">
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle2">按策略要求：≥8 位且同时含字母与数字</MudText>
            @if (!string.IsNullOrEmpty(_changePasswordError))
            {
                <MudAlert Severity="Severity.Error" Dense>@_changePasswordError</MudAlert>
            }
            <MudTextField T="string" Label="旧密码" @bind-Value="_oldPassword"
                          InputType="InputType.Password" Required="true" />
            <MudTextField T="string" Label="新密码" @bind-Value="_newPassword"
                          InputType="InputType.Password" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _showChangePasswordDialog = false)">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Loading="_changingPassword"
                   OnClick="ConfirmChangePasswordAsync">
            确认
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _drawerOpen = true;

    private bool _showChangePasswordDialog;
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _changePasswordError;
#pragma warning disable CS0414 // _changingPassword 在 Razor 标记中通过 MudButton Loading 绑定使用
    private bool _changingPassword;
#pragma warning restore CS0414
    private void OpenChangePasswordDialog()
    {
        _oldPassword = string.Empty;
        _newPassword = string.Empty;
        _changePasswordError = null;
        _showChangePasswordDialog = true;
    }

    private async Task ConfirmChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_oldPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _changePasswordError = "旧密码和新密码均为必填";
            return;
        }

        if (_newPassword.Length < 8 || !_newPassword.Any(char.IsLetter) || !_newPassword.Any(char.IsDigit))
        {
            _changePasswordError = "新密码至少 8 位且同时包含字母与数字";
            return;
        }

        _changingPassword = true;
        try
        {
            var (ok, status) = await Api.ChangeMyPasswordAsync(_oldPassword, _newPassword);
            if (!ok)
            {
                _changePasswordError = status == 400
                    ? "旧密码不正确或新密码不符合策略"
                    : $"修改失败（HTTP {status}）";
                return;
            }

            _showChangePasswordDialog = false;
            Snack.Add("密码已修改", Severity.Success);
        }
        finally
        {
            _changingPassword = false;
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private string ThemeToggleText => Theme.IsDark ? "切换亮色主题（车间终端）" : "切换暗色主题";

    private string ThemeToggleLabel => Theme.IsDark ? "切换亮色主题" : "切换暗色主题";

    private string ThemeToggleIcon => Theme.IsDark
        ? Icons.Material.Filled.LightMode
        : Icons.Material.Filled.DarkMode;

    private void GoLogin() => Navigation.NavigateTo("/login");

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task ToggleThemeAsync()
    {
        await Theme.ToggleAsync();
    }

    protected override void OnInitialized()
    {
        Theme.Changed += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.InitializeAsync();
            StateHasChanged();
        }
    }

    private string GetPageTitle()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        return AppRoutes.GetSectionLabel(path);
    }
}
